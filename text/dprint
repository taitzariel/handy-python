#!/usr/bin/python3

import sys


def strip_whitespace_outside_strings(text: str) -> str:
    """
    Remove all whitespace outside of quoted strings.

    Args:
        text: Input string with potential whitespace

    Returns:
        String with whitespace removed, except inside quotes
    """
    result = []
    in_string = False
    string_char = None
    i = 0

    while i < len(text):
        char = text[i]

        if not in_string:
            if char in ('"', "'"):
                in_string = True
                string_char = char
                result.append(char)
            elif not char.isspace():
                result.append(char)
        else:
            result.append(char)
            if char == string_char and (i == 0 or text[i - 1] != "\\"):
                in_string = False
                string_char = None

        i += 1

    return "".join(result)


def pretty_print_dict_str(dict_str: str, indent_size: int = 4) -> str:
    """
    Pretty print a string representation of a Python dict or object.

    Args:
        dict_str: String representation (e.g., from str(my_dict))
        indent_size: Number of spaces per indentation level

    Returns:
        Formatted string with proper indentation and line breaks
    """
    cleaned = strip_whitespace_outside_strings(dict_str)

    result = []
    indent_level = 0
    in_string = False
    string_char = None
    i = 0

    while i < len(cleaned):
        char = cleaned[i]

        if not in_string:
            if char in ('"', "'"):
                in_string = True
                string_char = char
                result.append(char)
            elif char in ("{", "[", "("):
                if i + 1 < len(cleaned) and cleaned[i + 1] in ("}", "]", ")"):
                    result.append(char)
                    result.append(cleaned[i + 1])
                    i += 1
                else:
                    result.append(char)
                    indent_level += 1
                    result.append("\n")
                    result.append(" " * (indent_level * indent_size))
            elif char in ("}", "]", ")"):
                indent_level -= 1
                result.append("\n")
                result.append(" " * (indent_level * indent_size))
                result.append(char)
            elif char == ",":
                result.append(char)
                result.append("\n")
                result.append(" " * (indent_level * indent_size))
            elif char == ":":
                result.append(char)
                result.append(" ")
            else:
                result.append(char)
        else:
            result.append(char)
            if char == string_char and (i == 0 or cleaned[i - 1] != "\\"):
                in_string = False
                string_char = None

        i += 1

    return "".join(result)


def dprint(line: str) -> None:
    """
    Pretty print a line containing dict representation.

    Args:
        line: String containing dict/object representation
    """
    formatted = pretty_print_dict_str(line.strip())
    print(formatted)


if __name__ == "__main__":
    full_input = sys.stdin.read()
    dprint(full_input)
